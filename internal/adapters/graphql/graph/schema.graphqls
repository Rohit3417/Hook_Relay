scalar Time

# ---------- Enums ----------

enum Tier {
  FREE
  PRO
  ENTERPRISE
}

enum EndpointStatus {
  ACTIVE
  PAUSED # set by the circuit breaker or manually
}

enum AttemptStatus {
  SUCCESS
  FAILED
}

# ---------- Core types ----------

type Tenant {
  id: ID!
  name: String!
  tier: Tier!
}

type Endpoint {
  id: ID!
  url: String!
  status: EndpointStatus!
  createdAt: Time!
  stats: EndpointStats!                  # resolver here is your N+1 -> dataloader target
  attempts(first: Int = 20, after: String): AttemptConnection!
}

type EndpointStats {
  totalDeliveries: Int!
  successRate: Float!                    # 0.0 - 1.0
  avgLatencyMs: Float!
  lastDeliveryAt: Time                   # nullable: a new endpoint has none
}

type Attempt {
  id: ID!
  eventId: ID!
  endpointId: ID!
  attemptNumber: Int!
  status: AttemptStatus!
  responseCode: Int                      # nullable: timeouts have no response
  durationMs: Int!
  error: String                          # nullable: only set on failure
  createdAt: Time!
}

# ---------- Pagination ----------

type AttemptConnection {
  edges: [AttemptEdge!]!
  pageInfo: PageInfo!
}

type AttemptEdge {
  cursor: String!
  node: Attempt!
}

type PageInfo {
  hasNextPage: Boolean!
  endCursor: String
}

# ---------- Metrics & billing ----------

input TimeRange {
  from: Time!
  to: Time!
}

type Metrics {
  eventsIngested: Int!
  deliveriesSucceeded: Int!
  deliveriesFailed: Int!
}

type Billing {
  tier: Tier!
  periodStart: Time!
  periodEnd: Time!
  eventsUsed: Int!
  eventsQuota: Int!
}

# ---------- Entry points ----------
# The tenant always comes from the auth context, never from an argument.

type Query {
  me: Tenant!
  endpoints: [Endpoint!]!
  endpoint(id: ID!): Endpoint            # nullable: not found / not yours
  metrics(range: TimeRange!): Metrics!
  billing: Billing!
}

input CreateEndpointInput {
  url: String!
}

type CreateEndpointPayload {
  endpoint: Endpoint!
}

type EndpointStatusPayload {
  endpoint: Endpoint!
}

type Mutation {
  createEndpoint(input: CreateEndpointInput!): CreateEndpointPayload!
  pauseEndpoint(id: ID!): EndpointStatusPayload!
  resumeEndpoint(id: ID!): EndpointStatusPayload!
}

type Subscription {
  deliveryAttempts(endpointId: ID): Attempt!   # optional filter, always tenant-scoped
}
